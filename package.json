{
  "name": "value-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dashboard DCA & analisis investasi multi-aset — open source, static, gratis.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "data:tv": "node scripts/fetch-tradingview.mjs",
    "data:fetch": "node scripts/fetch-prices.mjs",
    "data:compute": "node scripts/compute-dca.mjs",
    "data:fundamentals": "node scripts/compute-fundamentals.mjs",
    "data:all": "npm run data:fetch && npm run data:compute && npm run data:fundamentals"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lightweight-charts": "^5.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
